<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="argeoip">
        <job name="armah_geoip_clear_ip_logs" instance="Armah\Geoip\Cron\ClearIpLogs" method="execute">
            <schedule>0 0 * * *</schedule>
        </job>
        <job name="armah_geoip_sync_db" instance="Armah\Geoip\Cron\SyncDb" method="execute">
            <config_path>argeoip/refresh_ip_database/cron_schedule</config_path>
        </job>
    </group>
</config>
