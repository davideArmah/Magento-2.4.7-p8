<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Indexer/etc/indexer.xsd">
    <indexer id="armah_sorting_bestseller" view_id="armah_sorting_bestseller" class="Armah\Sorting\Model\Indexer\Bestsellers\BestsellersIndexer">
        <title translate="true">Armah Improved Sorting - Bestsellers</title>
        <description translate="true">Index Bestsellers. 'Update on Save' - to execute once a day by cron</description>
    </indexer>
    <indexer id="armah_sorting_revenue" view_id="armah_sorting_revenue" class="Armah\Sorting\Model\Indexer\Revenue\RevenueIndexer">
        <title translate="true">Armah Improved Sorting - Revenue</title>
        <description translate="true">Index Revenues. 'Update on Save' - to execute once a day by cron</description>
    </indexer>
    <indexer id="armah_sorting_most_viewed" view_id="armah_sorting_most_viewed" class="Armah\Sorting\Model\Indexer\MostViewed\MostViewedIndexer">
        <title translate="true">Armah Improved Sorting - Most Viewed</title>
        <description translate="true">Index Product Views. 'Update on Save' - to execute once a day by cron</description>
    </indexer>
    <indexer id="armah_sorting_wished" view_id="armah_sorting_wished" class="Armah\Sorting\Model\Indexer\Wished\WishedIndexer">
        <title translate="true">Armah Improved Sorting - Wishlists</title>
        <description translate="true">Index Wishlists. 'Update on Save' - to execute once a day by cron</description>
    </indexer>

    <indexer id="catalogsearch_fulltext">
        <dependencies>
            <indexer id="armah_sorting_bestseller" />
            <indexer id="armah_sorting_most_viewed" />
            <indexer id="armah_sorting_wished" />
        </dependencies>
    </indexer>
</config>
