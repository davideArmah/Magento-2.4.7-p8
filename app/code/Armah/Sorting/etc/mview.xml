<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Mview/etc/mview.xsd">
    <view id="armah_sorting_bestseller" class="Armah\Sorting\Model\Indexer\Bestsellers\BestsellersIndexer" group="indexer"/>
    <view id="armah_sorting_revenue" class="Armah\Sorting\Model\Indexer\Revenue\RevenueIndexer" group="indexer"/>
    <view id="armah_sorting_most_viewed" class="Armah\Sorting\Model\Indexer\MostViewed\MostViewedIndexer" group="indexer"/>
    <view id="armah_sorting_wished" class="Armah\Sorting\Model\Indexer\Wished\WishedIndexer" group="indexer"/>
    <view id="catalogsearch_fulltext" class="\Magento\CatalogSearch\Model\Indexer\Mview\Action" group="indexer">
        <subscriptions>
            <table name="armah_sorting_reviews_link" entity_column="product_id" />
        </subscriptions>
    </view>
</config>
