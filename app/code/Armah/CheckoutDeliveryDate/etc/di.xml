<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Armah\CheckoutDeliveryDate\Api\DeliveryInformationManagementInterface"
                type="Armah\CheckoutDeliveryDate\Model\DeliveryInformationManagement" />
    <preference for="Armah\CheckoutDeliveryDate\Api\GuestDeliveryInformationManagementInterface"
                type="Armah\CheckoutDeliveryDate\Model\GuestDeliveryInformationManagement" />
    <preference for="Armah\CheckoutDeliveryDate\Api\Data\DeliveryInterface"
                type="Armah\CheckoutDeliveryDate\Model\Delivery"/>

    <type name="Armah\CheckoutCore\Model\StatisticManagement">
        <arguments>
            <argument name="deliveryDateStatistic" xsi:type="object">Armah\CheckoutDeliveryDate\Model\DeliveryDateStatistic</argument>
        </arguments>
    </type>

    <type name="Magento\Sales\Block\Items\AbstractItems">
        <plugin name="Armah_CheckoutDeliveryDate::AddDeliveryInfo"
                type="Armah\CheckoutDeliveryDate\Plugin\Sales\Block\Items\AbstractItems\AddDeliveryInfo"
                sortOrder="10" />
    </type>
</config>
