<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="armah_cash_on_delivery_fee_quote" resource="default" engine="innodb" comment="Armah Cash on Delivery Fee Table">
    <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
    <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="true" identity="false" comment="Quote Id"/>
    <column xsi:type="decimal" name="amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Amount"/>
    <column xsi:type="decimal" name="base_amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Base Amount"/>
    <column xsi:type="decimal" name="tax_amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Tax Amount"/>
    <column xsi:type="decimal" name="base_tax_amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Base Tax Amount"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="entity_id"/>
    </constraint>
    <constraint xsi:type="foreign" referenceId="ARMAH_CASH_ON_DELIVERY_FEE_QUOTE_QUOTE_ID_QUOTE_ENTITY_ID" table="armah_cash_on_delivery_fee_quote" column="quote_id" referenceTable="quote" referenceColumn="entity_id" onDelete="SET NULL"/>
  </table>

  <table name="armah_cash_on_delivery_fee_order" resource="default" engine="innodb" comment="Armah Cash on Delivery Fee Table">
    <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
    <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" identity="false" comment="Order Id"/>
    <column xsi:type="decimal" name="amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Amount"/>
    <column xsi:type="decimal" name="base_amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Base Amount"/>
    <column xsi:type="decimal" name="tax_amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Tax Amount"/>
    <column xsi:type="decimal" name="base_tax_amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Base Tax Amount"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="entity_id"/>
    </constraint>
    <constraint xsi:type="foreign" referenceId="ARMAH_CASH_ON_DELIVERY_FEE_ORDER_ORDER_ID_SALES_ORDER_ENTITY_ID" table="armah_cash_on_delivery_fee_order" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="SET NULL"/>
  </table>
</schema>
