<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/sales.xsd">
    <section name="quote">
        <group name="totals">
            <item name="armah_cash_on_delivery_fee" instance="Armah\CashOnDelivery\Model\Quote\FeeCollector" sort_order="360"/>
        </group>
    </section>
    <section name="order_invoice">
        <group name="totals">
            <item name="armah_cash_on_delivery_fee" instance="Armah\CashOnDelivery\Model\Order\Invoice\Total\FeeCollector" sort_order="300"/>
        </group>
    </section>
    <section name="order_creditmemo">
        <group name="totals">
            <item name="armah_cash_on_delivery_fee" instance="Armah\CashOnDelivery\Model\Order\Creditmemo\Total\FeeCollector" sort_order="300" />
        </group>
    </section>
</config>
