<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Armah\SeoToolkitLite\Model\Config\Backend\ViewAllCanonical">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="messageManager" xsi:type="object">Magento\Framework\Message\ManagerInterface</item>
            </argument>
        </arguments>
    </type>

    <!-- Move SEO menu items to toolkit -->
    <type name="Magento\Backend\Model\Menu\Builder">
        <plugin name="Armah_SeoToolkitLite::Move_Menu" type="Armah\SeoToolkitLite\Plugin\Model\Menu\Builder" />
    </type>
</config>
