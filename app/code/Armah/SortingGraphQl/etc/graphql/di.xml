<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="Armah_SortingGraphQl::catalogToolbar" type="Armah\Sorting\Plugin\Catalog\Product\ProductList\Toolbar"/>
    </type>
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="Armah_SortingGraphQl::SortingMethodsProcessor"
                type="Armah\Sorting\Plugin\Catalog\Product\Collection"/>
    </type>

    <type name="Armah\Sorting\Plugin\CatalogSearch\Model\ResourceModel\Fulltext\Collection\ApplySorting">
        <arguments>
            <argument name="isFulltextCollection" xsi:type="boolean">true</argument>
        </arguments>
    </type>

    <type name="Magento\CatalogSearch\Model\ResourceModel\Fulltext\Collection">
        <plugin name="Armah_SortingGraphQl::SortingMethodsProcessor"
                type="Armah\Sorting\Plugin\CatalogSearch\Model\ResourceModel\Fulltext\Collection\ApplySorting"/>
    </type>
    <type name="Armah\Shopby\Model\ResourceModel\Fulltext\Collection">
        <plugin name="Armah_SortingGraphQl::SortingMethodsProcessor"
                type="Armah\Sorting\Plugin\CatalogSearch\Model\ResourceModel\Fulltext\Collection\ApplySorting"/>
    </type>
    <type name="Armah\ShopbyLite\Model\ResourceModel\Fulltext\Collection">
        <plugin name="Armah_SortingGraphQl::SortingMethodsProcessor"
                type="Armah\Sorting\Plugin\CatalogSearch\Model\ResourceModel\Fulltext\Collection\ApplySorting"/>
    </type>

    <!--    fix stock status for GraphQl-->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="Armah_SortingGraphQl::add_stock_information"
                type="Armah\SortingGraphQl\Plugin\Catalog\Model\ResourceModel\Product\CollectionPlugin"/>
    </type>

    <type name="Armah\Sorting\Block\Widget\Featured">
        <plugin name="Armah_SortingGraphQl::addConfig" type="Armah\SortingGraphQl\Plugin\Block\Widget\Featured\AddWidgetParams" />
    </type>

    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\MediaGallery\Url">
        <plugin name="Armah_SortingGraphQl::get-relative-path" type="Armah\SortingGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Product\MediaGallery\Url\CutBaseUrl" />
    </type>

    <!-- fix for elastic engine; because when elastic sorting is double! in elastic and after in mysql -->
    <type name="Magento\CatalogGraphQl\DataProvider\Product\SearchCriteriaBuilder">
        <plugin name="Armah_SortingGraphQl::add-default-orders" type="Armah\SortingGraphQl\Plugin\CatalogGraphQl\DataProvider\Product\SearchCriteriaBuilder\AddDefaultOrders" sortOrder="10" />
    </type>
    <type name="Magento\CatalogGraphQl\DataProvider\Product\SearchCriteriaBuilder">
        <plugin name="Armah_SortingGraphQl::fix-order-code" type="Armah\SortingGraphQl\Plugin\CatalogGraphQl\DataProvider\Product\SearchCriteriaBuilder\FixSortOrderCode" sortOrder="11" />
    </type>
    <type name="Armah\Sorting\Model\MethodProvider">
        <plugin name="Armah_SortingGraphQl::fix-method-code" type="Armah\SortingGraphQl\Plugin\Sorting\Model\MethodProvider\FixMethodCode" />
    </type>
    <type name="Armah\Sorting\Model\Method\GetAttributeCodesForSorting">
        <plugin name="Armah_SortingGraphQl::disable-code-map"
                type="Armah\SortingGraphQl\Plugin\Sorting\Model\Method\GetAttributeCodesForSorting\DisableCodeMap" />
    </type>

    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\Query\Search">
        <plugin name="Armah_SortingGraphQl::detect-search-page" type="Armah\SortingGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Products\Query\Search\SetSearchFlag" />
    </type>
    <type name="Armah\Sorting\Model\IsSearchPage">
        <plugin name="Armah_SortingGraphQl::detect-search-page" type="Armah\SortingGraphQl\Plugin\Sorting\Model\IsSearchPage\DetectSearchPage" />
    </type>

    <type name="Magento\Catalog\Model\Category\Attribute\Source\Sortby">
        <plugin name="Armah_SortingGraphQl::SortingAllOptions" type="Armah\SortingGraphQl\Plugin\Catalog\Model\Category\Attribute\Source\Sortby"/>
    </type>
</config>
