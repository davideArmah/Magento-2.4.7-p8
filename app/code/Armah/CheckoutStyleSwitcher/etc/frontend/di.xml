<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Block\Onepage">
        <arguments>
            <argument name="layoutProcessors" xsi:type="array">
                <item name="armahCheckoutPlaceOrderPosition" sortOrder="101" xsi:type="object">Armah\CheckoutStyleSwitcher\Block\Onepage\PlaceOrderPositionProcessor</item>
                <item name="armahCheckoutBillingAddressRelocation" sortOrder="110" xsi:type="object">Armah\CheckoutStyleSwitcher\Block\Onepage\BillingAddressRelocateProcessor</item>
            </argument>
        </arguments>
    </type>
</config>
