<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Sales\Block\Order\Info">
        <plugin name="Armah_Orderattr::OrderViewAttributesList" type="Armah\Orderattr\Block\Order\Plugin\OrderView" />
    </type>
    <type name="Magento\Checkout\Block\Onepage">
        <arguments>
            <argument name="layoutProcessors" xsi:type="array">
                <item name="orderAttributes" xsi:type="object">Armah\Orderattr\Block\Checkout\LayoutProcessor</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Customer\Block\SectionConfig">
        <arguments>
            <argument name="clientSideSections" xsi:type="array">
                <item name="armah-checkout-data" xsi:type="string">armah-checkout-data</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="armah_order_attribute_config_provider" xsi:type="object">Armah\Orderattr\Model\Checkout\CheckoutConfigProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Armah\Orderattr\Model\Attribute\InputType\FrontendCaster">
        <arguments>
            <argument name="specificationProcessorClasses" xsi:type="array">
                <item name="multiselect" xsi:type="string">Armah\Orderattr\Model\Attribute\InputType\FrontendCaster\Multiselect</item>
                <item name="date" xsi:type="string">Armah\Orderattr\Model\Attribute\InputType\FrontendCaster\Date</item>
                <item name="datetime" xsi:type="string">Armah\Orderattr\Model\Attribute\InputType\FrontendCaster\Datetime</item>
                <item name="file" xsi:type="string">Armah\Orderattr\Model\Attribute\InputType\FrontendCaster\File</item>
            </argument>
        </arguments>
    </type>

    <type name="Armah\Orderattr\Block\Paypal\Attributes">
        <arguments>
            <argument name="serializer" xsi:type="object">Magento\Framework\Serialize\Serializer\JsonHexTag</argument>
        </arguments>
    </type>
</config>
