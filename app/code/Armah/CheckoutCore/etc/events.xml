<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="payment_cart_collect_items_and_amounts">
        <observer name="armah_checkout"
                  instance="Armah\CheckoutCore\Observer\Payment\Model\Cart\CollectTotalsAndAmounts" />
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="Armah_CheckoutCore::set_comment" instance="Armah\CheckoutCore\Observer\QuoteSubmit\BeforeSubmitObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="Armah_CheckoutCore::set_orderid" instance="Armah\CheckoutCore\Observer\QuoteSubmit\AfterSubmitObserver"/>
        <observer name="Armah_CheckoutCore::sales_model_service_quote_submit" instance="Armah\CheckoutCore\Observer\Sales\Model\Service\Quote\Submit" />
    </event>
    <event name="customer_address_format">
        <observer name="Armah_CheckoutCore::order_address_renderer" instance="Armah\CheckoutCore\Observer\Order\RendererAddressFormat" />
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="Armah_CheckoutCore::sales_model_service_quote_submit" instance="Armah\CheckoutCore\Observer\Sales\Model\Service\Quote\Submit" />
    </event>
    <event name="adminhtml_cache_flush_all">
        <observer name="Armah_CheckoutCore::delete_bundle" instance="Armah\CheckoutCore\Observer\AdminhtmlCacheFlushAll"/>
    </event>

    <!--  Process GDPR consent codes  -->
    <event name="sales_order_place_after">
        <observer name="Armah_CheckoutCore::process_gdpr_consents" instance="Armah\CheckoutCore\Observer\QuoteSubmit\ProcessGdprConsents" />
        <observer name="armah_gdpr" disabled="true" />
    </event>

    <event name="armah_orderattr_entity_attribute_save_before">
        <observer name="Armah_CheckoutCore::armah_orderattr_entity_attribute_save_before"
                  instance="Armah\CheckoutCore\Observer\OrderAttribute\UpdateSortOrder" />
    </event>

    <event name="armah_orderattr_entity_attribute_save_after">
        <observer name="armah_orderattr_entity_attribute_save_after"
                  instance="Armah\CheckoutCore\Observer\OrderAttribute\InvalidateCache" />
    </event>
    <event name="armah_orderattr_entity_attribute_delete_after">
        <observer name="Armah_CheckoutCore::armah_orderattr_entity_attribute_delete_after"
                  instance="Armah\CheckoutCore\Observer\OrderAttribute\InvalidateCache" />
    </event>

    <event name="armah_customer_attributes_before_save">
        <observer name="Armah_CheckoutCore::armah_customer_attributes_before_save"
                  instance="Armah\CheckoutCore\Observer\CustomerAttribute\UpdateSortOrder" />
    </event>

    <event name="customer_attributes_after_save">
        <observer name="Armah_CheckoutCore::customer_attributes_after_save"
                  instance="Armah\CheckoutCore\Observer\CustomerAttribute\InvalidateCache" />
    </event>
    <event name="customer_attributes_delete_after">
        <observer name="Armah_CheckoutCore::customer_attributes_delete_after"
                  instance="Armah\CheckoutCore\Observer\CustomerAttribute\InvalidateCache" />
    </event>
</config>
