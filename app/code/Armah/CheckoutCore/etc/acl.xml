<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Armah_CheckoutCore::config_checkout" title="Armah One Step Checkout" sortOrder="151419" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::system">
                    <resource id="Armah_CheckoutCore::checkout_settings" title="Armah One Step Checkout" translate="title" sortOrder="151419">
                        <resource id="Armah_CheckoutCore::checkout_settings_fields" title="Manage Checkout Fields" translate="title" sortOrder="10" />
                    </resource>
                </resource>
                <resource id="Magento_Reports::report">
                    <resource id="Magento_Reports::report_marketing">
                        <resource id="Armah_CheckoutCore::reports" sortOrder="192012" title="Checkout Analytics" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
