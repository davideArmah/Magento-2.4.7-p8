<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="admin_sales_order_address_update">
        <observer name="Armah_CheckoutCore::sales_order_address_save" instance="Armah\CheckoutCore\Observer\Admin\Order\AddressSave" />
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="Armah_CheckoutCore::set_custom_fields" instance="Armah\CheckoutCore\Observer\Admin\QuoteSubmit\BeforeAdminSubmitObserver"/>
    </event>
    <event name="customer_entity_attribute_save_after">
        <observer name="Armah_CheckoutCore::customer_entity_attribute_save_after"
                  instance="Armah\CheckoutCore\Observer\Admin\Customer\Attribute\UpdateFieldAfterSave" />
    </event>
    <event name="admin_system_config_changed_section_armah_checkout">
        <observer name="Armah_CheckoutCore::save_armah_checkout"
                  instance="Armah\CheckoutCore\Observer\System\ConfigChanged"/>
    </event>
    <event name="admin_system_config_changed_section_amsociallogin">
        <observer name="Armah_CheckoutCore::save_armah_social_login"
                  instance="Armah\CheckoutCore\Observer\System\ConfigChanged"/>
    </event>
</config>
