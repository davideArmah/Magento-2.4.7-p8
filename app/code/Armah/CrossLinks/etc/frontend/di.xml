<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Cms\Block\Page">
        <plugin name="crossLinksCmsReplaceContent" type="Armah\CrossLinks\Plugin\Cms\Block\Page"/>
    </type>

    <!-- Start Armah Faq section -->
    <type name="Armah\Faq\Block\View\Question">
        <plugin name="Armah_CrossLink::faq_compatibility_question" type="Armah\CrossLinks\Plugin\Faq"/>
    </type>
    <type name="Armah\Faq\Block\View\Category">
        <plugin name="Armah_CrossLink::faq_compatibility_category" type="Armah\CrossLinks\Plugin\Faq"/>
    </type>
    <!-- End Armah Faq section -->

    <!--    Start Armah Blog section-->
    <type name="Armah\Blog\Model\Posts">
        <plugin name="Armah_CrossLinks::blog_compatibility_post" type="Armah\CrossLinks\Plugin\Blog\Model\PostsPlugin"/>
    </type>
    <!--    End Armah Blog section-->
</config>
