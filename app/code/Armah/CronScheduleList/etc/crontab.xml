<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job instance="Armah\CronScheduleList\Cron\Activity" method="execute" name="armah_cron_activity">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
