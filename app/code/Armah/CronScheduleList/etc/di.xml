<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Cron\Model\ResourceModel\Schedule\Collection">
        <plugin name="Armah_CronScheduleList::idfieldname" type="Armah\CronScheduleList\Plugin\ScheduleCollectionPlugin" />
    </type>
    <type name="Armah\CronScheduleList\Controller\Adminhtml\Schedule\RunCron">
        <arguments>
            <argument name="shell" xsi:type="object">shellBackground</argument>
        </arguments>
    </type>
</config>
