<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sales.order.view">
            <block class="Magento\Sales\Block\Order\View" name="armah_checkout_gift_wrap" template="Armah_CheckoutGiftWrap::onepage/details/order/view.phtml"/>
        </referenceBlock>

        <referenceBlock name="order_totals">
            <block class="Armah\CheckoutGiftWrap\Block\Sales\Order\Fee" name="armah_checkout_fee"/>
        </referenceBlock>
    </body>
</page>
