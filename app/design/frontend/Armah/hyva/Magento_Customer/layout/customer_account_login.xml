<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Customer Login</title>
    </head>
    <body>
        <referenceBlock name="topmenu_desktop" remove="true"/>
        <referenceContainer name="sidebar.main" htmlTag="div" htmlClass="flex flex-col-reverse">
            <container name="wrapper.navigation.left" htmlTag="div" htmlClass="sidebar sidebar-main order-1">
                <block name="navigation.left" class="Magento\Catalog\Block\Navigation" template="Magento_Theme::html/header/menu/desktop.phtml" before="-"/>
            </container>
            
        </referenceContainer>
        <referenceBlock class="Magento\Theme\Block\Html\Title" name="page.main.title" template="Magento_Theme::html/title.phtml" remove="true"/>
        <referenceContainer name="content">
            <container name="customer.login.container" htmlTag="div" htmlId="customer-login-container" htmlClass="login-container">
                <container name="customer.login.container.container" htmlTag="div" htmlId="customer-login-container-container" htmlClass="shadow-xl flex w-full py-4">
                    <block class="Magento\Customer\Block\Form\Login" name="customer_form_login" template="Magento_Customer::form/login.phtml">
                        <container name="form.additional.info" as="form_additional_info"/>
                    </block>
                    <block class="Magento\Customer\Block\Form\Login\Info" name="customer.new" template="Magento_Customer::newcustomer.phtml"/>
                </container>
            </container>
        </referenceContainer>

    </body>
</page>
