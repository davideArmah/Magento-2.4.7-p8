<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="catalog_list_item" />
    <body>
        <referenceBlock name="topmenu_desktop" remove="true"/>
        <referenceBlock name="category.description" remove="true"/>
        <referenceContainer name="sidebar.main" htmlTag="div" htmlClass="flex flex-col-reverse">
            <container name="wrapper.navigation.left" htmlTag="div" htmlClass="sidebar sidebar-main order-1">
                <block name="navigation.left" class="Magento\Catalog\Block\Navigation" template="Magento_Theme::html/header/menu/desktop.phtml" before="-"/>
            </container>
            <referenceContainer name="category.view.container" htmlId="category-view-container" htmlClass="category-view container" remove="true"/>

        </referenceContainer>
        <referenceContainer name="content">
            <block name="page.main.title" class="Magento\Theme\Block\Html\Title" template="Magento_Theme::html/title.phtml" before="category.description.top"/>
            <block class="Magento\Catalog\Block\Category\View" name="category.description.top" template="Magento_PageBuilder::catalog/category/view/description-top.phtml" before="-"/>
            <block class="Magento\Catalog\Block\Category\View" name="category.description.bottom" template="Magento_PageBuilder::catalog/category/view/description-bottom.phtml" before="footer"/>
        </referenceContainer>
        <referenceContainer name="footer">
            <container name="footer.block.strip.container" label="Footer Block Strip Container" htmlTag="div" htmlClass="footer-block-strip-container my-1" before="footer-content">
                <block class="Magento\Cms\Block\Block" name="blocco-banner">
                    <arguments>
                        <argument name="block_id" xsi:type="string">blocco-banner</argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>
    </body>
</page>
